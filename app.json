{
  "expo": {
    "name": "FAWA Winter Arc",
    "slug": "fawa-winter-arc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07110A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fawa.winterarc",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "processing"],
        "NSLocationWhenInUseUsageDescription": "Used only to fetch local air quality data for workout safety. Fully optional and can be skipped.",
        "NSPhotoLibraryUsageDescription": "Used to save and view your progress photos.",
        "NSPhotoLibraryAddUsageDescription": "Used to save your progress photos to your photo library.",
        "UNUserNotificationCenter": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07110A"
      },
      "package": "com.fawa.winterarc",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2BE36B",
          "sounds": ["./assets/sounds/alarm.wav", "./assets/sounds/gentle.wav"],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FAWA uses your location only to check local air quality for safe outdoor workouts. This is optional."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FAWA accesses your photos to let you save progress photos."
        }
      ],
      ["expo-audio", {}]
    ],
    "scheme": "fawa",
    "experiments": {
      "typedRoutes": true
    }
  }
}
